---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Card from '@/components/ui/Card.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const profesores = await getCollection('profesores');
---

<BaseLayout
  title="Conócenos"
  description="Conoce la historia, los valores y el equipo de profesores de nuestra escuela de baile."
>
  <Breadcrumbs items={[{ label: 'Conócenos', href: '/conocenos' }]} />
  <Section>
    <Container>
      <h1 class="text-4xl font-extrabold">Conócenos</h1>
      <div class="mt-8 max-w-3xl space-y-4 text-lg">
        <h2 class="text-2xl font-bold">Nuestra historia</h2>
        <p>
          Texto de ejemplo: nacimos con la idea de que bailar debe ser accesible y divertido para
          todo el mundo, sin importar la edad ni la experiencia.
        </p>
        <h2 class="text-2xl font-bold">Nuestros valores</h2>
        <p>
          Texto de ejemplo: cercanía, respeto, constancia y ganas de pasarlo bien en cada clase.
        </p>
      </div>
    </Container>
  </Section>
  <Section class="bg-white">
    <Container>
      <h2 class="text-3xl font-bold">Nuestros profesores</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {profesores.map((p) => (
          <li>
            <Card class="h-full overflow-hidden p-0">
              <Image
                src={p.data.foto}
                alt={`Retrato de ${p.data.nombre}, profesor de ${p.data.especialidad}`}
                widths={[300, 600]}
                sizes="(min-width: 1024px) 264px, (min-width: 640px) 50vw, 100vw"
                class="aspect-square w-full object-cover"
              />
              <div class="p-6">
                <h3 class="text-xl font-bold">{p.data.nombre}</h3>
                <p class="font-semibold text-cielo">{p.data.especialidad}</p>
                {p.data.bio && <p class="mt-2">{p.data.bio}</p>}
              </div>
            </Card>
          </li>
        ))}
      </ul>
    </Container>
  </Section>
</BaseLayout>
