---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import AgendaMovil from '@/components/horarios/AgendaMovil.astro';
import AgendaTabla from '@/components/horarios/AgendaTabla.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { getClases } from '@/lib/clases';

interface Props {
  baile: CollectionEntry<'bailes'>;
}

export async function getStaticPaths() {
  const bailes = await getCollection('bailes');
  return bailes.map((baile) => ({ params: { slug: baile.id }, props: { baile } }));
}

const { baile } = Astro.props;
const { Content } = await render(baile);
const clases = await getClases(baile.id);
const { data } = baile;
---

<BaseLayout title={data.seoTitle} description={data.seoDescription} image={data.portada.src}>
  <Breadcrumbs
    items={[
      { label: 'Bailes', href: '/bailes' },
      { label: data.nombre, href: `/bailes/${baile.id}` },
    ]}
  />
  <Section>
    <Container>
      <h1 class="text-4xl font-extrabold">
        Clases de {data.nombre.toLowerCase()} en {SITE.address.city}
      </h1>
      <Image
        src={data.portada}
        alt={data.portadaAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1152px) 1088px, 100vw"
        loading="eager"
        class="mt-8 aspect-[3/2] w-full max-w-3xl rounded-2xl object-cover"
      />
      <div class="mt-8 max-w-3xl space-y-4 text-lg [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold">
        <Content />
      </div>
      {clases.length > 0 && (
        <div class="mt-12">
          <h2 class="text-2xl font-bold">Horarios de {data.nombre.toLowerCase()}</h2>
          <div class="mt-4">
            <AgendaTabla clases={clases} />
            <AgendaMovil clases={clases} />
          </div>
        </div>
      )}
      <Button href={`/reservar?baile=${baile.id}`} class="mt-10">
        Reservar clase de {data.nombre}
      </Button>
    </Container>
  </Section>
</BaseLayout>
