---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import Card from '@/components/ui/Card.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog"
  description="Consejos, guías y novedades para aprender a bailar salsa, bachata, breakdance y más."
>
  <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }]} />
  <Section>
    <Container>
      <h1 class="text-4xl font-extrabold">Blog</h1>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <li>
            <Card class="h-full overflow-hidden p-0">
              <Image
                src={post.data.cover}
                alt={post.data.coverAlt}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 384px, (min-width: 640px) 50vw, 100vw"
                class="aspect-[3/2] w-full object-cover"
              />
              <div class="p-6">
                <h2 class="text-xl font-bold">
                  <a
                    href={`/blog/${post.id}`}
                    class="underline-offset-4 hover:underline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-oceano"
                  >
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-1 text-sm">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('es-ES', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                </p>
                <p class="mt-2">{post.data.description}</p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <li>
                      <Badge>{tag}</Badge>
                    </li>
                  ))}
                </ul>
              </div>
            </Card>
          </li>
        ))}
      </ul>
    </Container>
  </Section>
</BaseLayout>
