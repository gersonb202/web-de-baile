---
import { NAV_ITEMS } from '@/config/nav';
---

<div class="md:hidden" data-mobile-nav>
  <button
    type="button"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label="Abrir menú"
    data-mobile-nav-toggle
    class="inline-flex size-11 items-center justify-center rounded-full text-oceano focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-oceano"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      class="size-6"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <path d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>
  <nav
    id="mobile-menu"
    aria-label="Principal móvil"
    hidden
    class="absolute inset-x-0 top-full bg-crema shadow-md"
  >
    <ul class="flex flex-col p-4">
      {NAV_ITEMS.map((item) => (
        <li>
          <a
            href={item.href}
            class="flex min-h-11 items-center rounded-lg px-3 font-semibold text-oceano hover:bg-oceano hover:text-crema focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-oceano"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const toggle = root?.querySelector<HTMLButtonElement>('[data-mobile-nav-toggle]');
  const menu = root?.querySelector<HTMLElement>('#mobile-menu');

  if (root && toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      menu.hidden = !open;
      if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
