---
interface Props {
  items: { pregunta: string; respuesta: string }[];
}

const { items } = Astro.props;
---

<div class="space-y-3">
  {items.map((item) => (
    <details class="rounded-2xl bg-white p-4 shadow-sm">
      <summary class="flex min-h-11 cursor-pointer items-center font-semibold text-oceano focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-oceano">
        {item.pregunta}
      </summary>
      <p class="mt-2">{item.respuesta}</p>
    </details>
  ))}
</div>
