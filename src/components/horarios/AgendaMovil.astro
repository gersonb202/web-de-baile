---
import { colorBaile, nombreBaile } from './colores';
import { agruparPorDia, DIA_LABEL, type Clase } from '@/lib/horarios';

interface Props {
  clases: Clase[];
}

const grupos = agruparPorDia(Astro.props.clases);
---

<div class="space-y-8 md:hidden">
  {grupos.map((g) => (
    <section>
      <h3 class="text-2xl font-bold">{DIA_LABEL[g.dia]}</h3>
      <ul class="mt-3 space-y-3">
        {g.clases.map((c) => (
          <li class:list={['rounded-lg p-4 text-noche', colorBaile(c.baile)]}>
            <p class="font-bold">{nombreBaile(c.baile)}</p>
            <p>
              {c.inicio}–{c.fin} · {c.nivel}
            </p>
            <p>{c.profesor}</p>
            <a
              href={`/reservar?baile=${c.baile}`}
              aria-label={`Probar gratis ${nombreBaile(c.baile)} el ${DIA_LABEL[c.dia].toLowerCase()} a las ${c.inicio}`}
              class="inline-flex min-h-11 items-center font-semibold underline underline-offset-4 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-oceano"
            >
              Probar gratis
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
